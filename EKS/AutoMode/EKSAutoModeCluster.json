{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Create an Amazon EKS cluster with Auto Mode for simplified Kubernetes management. This template demonstrates modern EKS setup with automatic node provisioning.",
    "Parameters": {
        "ClusterName": {
            "Description": "Name for the EKS cluster",
            "Type": "String",
            "Default": "eks-auto-cluster",
            "MinLength": 1,
            "MaxLength": 100
        },
        "KubernetesVersion": {
            "Description": "Kubernetes version",
            "Type": "String",
            "AllowedValues": [
                "1.30",
                "1.31"
            ],
            "Default": "1.31"
        }
    },
    "Resources": {
        "EKSServiceRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "eks.amazonaws.com"
                            },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
                ]
            }
        },
        "EKSAutoModeCluster": {
            "Type": "AWS::EKS::Cluster",
            "Properties": {
                "Name": {
                    "Ref": "ClusterName"
                },
                "Version": {
                    "Ref": "KubernetesVersion"
                },
                "RoleArn": {
                    "Fn::GetAtt": [
                        "EKSServiceRole",
                        "Arn"
                    ]
                },
                "ComputeConfig": {
                    "Enabled": true,
                    "NodePools": [
                        "general-purpose"
                    ],
                    "NodeRoleArn": {
                        "Fn::GetAtt": [
                            "EKSNodeRole",
                            "Arn"
                        ]
                    }
                },
                "StorageConfig": {
                    "BlockStorage": {
                        "Enabled": true
                    }
                },
                "KubernetesNetworkConfig": {
                    "IpFamily": "ipv4"
                },
                "AccessConfig": {
                    "AuthenticationMode": "API_AND_CONFIG_MAP",
                    "BootstrapClusterCreatorAdminPermissions": true
                },
                "Tags": {
                    "Environment": "Development",
                    "ManagedBy": "CloudFormation"
                }
            }
        },
        "EKSNodeRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ec2.amazonaws.com"
                            },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
                    "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy",
                    "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly"
                ]
            }
        }
    },
    "Outputs": {
        "ClusterName": {
            "Description": "EKS Cluster Name",
            "Value": {
                "Ref": "EKSAutoModeCluster"
            },
            "Export": {
                "Name": {
                    "Fn::Sub": "${AWS::StackName}-ClusterName"
                }
            }
        },
        "ClusterArn": {
            "Description": "EKS Cluster ARN",
            "Value": {
                "Fn::GetAtt": [
                    "EKSAutoModeCluster",
                    "Arn"
                ]
            },
            "Export": {
                "Name": {
                    "Fn::Sub": "${AWS::StackName}-ClusterArn"
                }
            }
        },
        "ClusterEndpoint": {
            "Description": "EKS Cluster API Endpoint",
            "Value": {
                "Fn::GetAtt": [
                    "EKSAutoModeCluster",
                    "Endpoint"
                ]
            },
            "Export": {
                "Name": {
                    "Fn::Sub": "${AWS::StackName}-ClusterEndpoint"
                }
            }
        }
    }
}
